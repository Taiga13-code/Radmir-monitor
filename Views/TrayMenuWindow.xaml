<Window x:Class="RadmirMonitor.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">
    <Border Background="#F2191A1D" BorderBrush="#3D4146" BorderThickness="1" CornerRadius="14" Padding="8" Width="235">
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.38" Color="#000000"/></Border.Effect>
        <StackPanel>
            <Grid Margin="10,8,10,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="RADMIR MONITOR" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="v3.2.0" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,2,0,0"/>
                </StackPanel>
                <Ellipse x:Name="StateDot" Grid.Column="1" Width="8" Height="8" Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/>
            </Grid>

            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="Открыть Monitor" Click="Open_Click" Margin="0,1"/>
            <Button x:Name="MonitorButton" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="Запустить мониторинг" Click="Monitor_Click" Margin="0,1"/>
            <Button x:Name="OverlayButton" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Content="Оверлей: включён" Click="Overlay_Click" Margin="0,1"/>
            <Border Height="1" Background="#35373B" Margin="8,7"/>
            <Button Style="{StaticResource DangerButton}" HorizontalContentAlignment="Left" Content="Выйти" Click="Exit_Click" Margin="0,1"/>
        </StackPanel>
    </Border>
</Window>

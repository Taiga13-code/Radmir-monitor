<Window x:Class="RadmirMonitor.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Background="#F20F172A" BorderBrush="#344565" BorderThickness="1" CornerRadius="15" Padding="15,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="РЕПОРТЫ" Foreground="#8595B3" FontSize="9" FontWeight="SemiBold"/>
                <TextBlock x:Name="ReportsText" Text="0" Foreground="#F4F7FF" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Width="1" Background="#293852" Margin="8,2"/>
            <StackPanel Grid.Column="2">
                <TextBlock Text="ОНЛАЙН" Foreground="#8595B3" FontSize="9" FontWeight="SemiBold"/>
                <TextBlock x:Name="OnlineText" Text="0:00" Foreground="#46DBA0" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="3" Width="1" Background="#293852" Margin="8,2"/>
            <StackPanel Grid.Column="4">
                <TextBlock Text="НАКАЗАНИЯ" Foreground="#8595B3" FontSize="9" FontWeight="SemiBold"/>
                <TextBlock x:Name="PunishmentsText" Text="0" Foreground="#8C75FF" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

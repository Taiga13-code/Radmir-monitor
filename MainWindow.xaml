<Window x:Class="RadmirMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Radmir Monitor Offline 3.1.0"
        Width="1240" Height="800" MinWidth="1060" MinHeight="690"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="14" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#1F2B48" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="184"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,18,20,10">
                    <Border CornerRadius="22" Background="Transparent" BorderThickness="0" ClipToBounds="False">
                        <Image Source="Assets/cat_logo.png"
                               Stretch="Uniform"
                               Margin="4"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" x:Name="NavPanel" Margin="0,6,0,0">
                    <RadioButton x:Name="DashboardNav" GroupName="Nav" Tag="Dashboard" Content="Обзор" Style="{StaticResource NavRadioStyle}" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="HistoryNav" GroupName="Nav" Tag="History" Content="История" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NormNav" GroupName="Nav" Tag="Norm" Content="Норма" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="SettingsNav" GroupName="Nav" Tag="Settings" Content="Настройки" Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="22,10,22,22">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource RedBrush}" Margin="0,5,8,0"/>
                        <TextBlock x:Name="StatusText" Text="Остановлен" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="Radmir Monitor Offline" Foreground="#697895" FontSize="10"/>
                    <TextBlock Text="v3.1.0" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>

            <!-- custom title bar -->
            <Border Grid.Row="0" Background="#0C1222" BorderBrush="#1D2945" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="26,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText" Text="Обзор" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DashboardNickText" Text="Профиль не настроен" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="—" Width="36" Height="32" Padding="0" Click="Minimize_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="□" Width="36" Height="32" Padding="0" Click="Maximize_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="×" Foreground="#FF8995" Width="36" Height="32" Padding="0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="24,20,24,12">

                <!-- DASHBOARD -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                    <StackPanel>
                        <!-- Monitoring is the primary action -->
                        <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="МОНИТОРИНГ" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Ellipse x:Name="HeroStatusDot" Width="11" Height="11" Fill="{StaticResource RedBrush}" Margin="0,7,10,0"/>
                                        <TextBlock x:Name="HeroStatusText" Text="Остановлен" FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MonitorPathText" Text="chatlog.txt не выбран" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" MaxWidth="650"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="StartStopButton" Style="{StaticResource HeroButton}" Content="ЗАПУСТИТЬ" Click="StartStop_Click" VerticalAlignment="Center" Margin="28,0,0,0"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Репорты сегодня" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ReportsTodayText" Text="0" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Онлайн сегодня" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="OnlineTodayText" Text="0ч 00м" Foreground="{StaticResource GreenBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Наказания" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PunishmentsTodayText" Text="0" Foreground="#A58EFF" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
                            <Border Grid.Column="6" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Репортов / час" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="ReportsPerHourText" Text="0.0" Foreground="#63C8FF" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="Последние наказания" Style="{StaticResource SectionTitle}"/>
                                    <DataGrid Grid.Row="2" x:Name="DashboardHistoryGrid" Height="225" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="95"/>
                                            <DataGridTextColumn Header="Игрок" Binding="{Binding Player}" Width="*"/>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="58"/>
                                            <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="1.4*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Журнал Monitor" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                    <ListBox x:Name="LogList" Height="225"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- HISTORY -->
                <ScrollViewer x:Name="HistoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="HistorySearchBox" KeyDown="HistorySearchBox_KeyDown"/>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Найти" Click="SearchHistory_Click" Padding="14,8"/>
                                    <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Сброс" Click="ResetHistory_Click" Padding="14,8"/>
                                </Grid>
                                <DataGrid Grid.Row="2" x:Name="HistoryGrid" Height="540" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="110"/>
                                        <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="105"/>
                                        <DataGridTextColumn Header="Игрок" Binding="{Binding Player}" Width="190"/>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65"/>
                                        <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"/>
                                        <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- NORM -->
                <ScrollViewer x:Name="NormPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Репорты / 31 д." Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="HistoryReportsText" Text="0" Foreground="{StaticResource TextBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Наказания / 31 д." Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="HistoryPunishmentsText" Text="0" Foreground="#A58EFF" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Онлайн / 31 д." Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="HistoryOnlineText" Text="0ч 00м" Foreground="{StaticResource GreenBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                            <Border Grid.Column="6" Style="{StaticResource StatCardStyle}"><StackPanel><TextBlock Text="Лучший день" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="BestDayText" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="Норма по дням" Style="{StaticResource SectionTitle}"/>
                                    <DataGrid Grid.Row="2" x:Name="DailyGrid" Height="470" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Дата" Binding="{Binding Day}" Width="*"/>
                                            <DataGridTextColumn Header="Реп" Binding="{Binding Report}" Width="58"/>
                                            <DataGridTextColumn Header="Бан" Binding="{Binding Ban}" Width="52"/>
                                            <DataGridTextColumn Header="Мут" Binding="{Binding Mute}" Width="52"/>
                                            <DataGridTextColumn Header="Кик" Binding="{Binding Kick}" Width="52"/>
                                            <DataGridTextColumn Header="Варн" Binding="{Binding Warn}" Width="56"/>
                                            <DataGridTextColumn Header="Дем" Binding="{Binding Jail}" Width="52"/>
                                            <DataGridTextColumn Header="Онлайн" Binding="{Binding OnlineText}" Width="86"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="iPhone" Style="{StaticResource SectionTitle}"/><CheckBox Grid.Column="1" x:Name="MobileEnabledCheck" Content="Включено" Checked="MobileChanged" Unchecked="MobileChanged"/></Grid>
                                        <Border Width="150" Height="150" HorizontalAlignment="Left" Background="White" CornerRadius="14" Padding="8"><Image x:Name="MobileQrImage" Stretch="Uniform"/></Border>
                                        <TextBox x:Name="MobileUrlBox" IsReadOnly="True" Margin="0,14,0,9"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Копировать ссылку" HorizontalAlignment="Left" Click="CopyMobileUrl_Click"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="Цели" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                        <TextBlock Text="Репорты / день" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ReportGoalBox" Margin="0,0,0,12"/>
                                        <TextBlock Text="Онлайн / день, мин" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="OnlineGoalBox"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="PageScroll_PreviewMouseWheel">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Профиль и пути" Style="{StaticResource SectionTitle}" Margin="0,0,0,16"/>
                                        <TextBlock Text="Ник" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NickBox" Margin="0,0,0,12"/>

                                        <TextBlock Text="chatlog.txt" Style="{StaticResource FieldLabel}"/>
                                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ChatLogBox"/><Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Авто" Click="AutoChatLog_Click"/><Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Выбрать" Click="BrowseChatLog_Click"/></Grid>

                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Приложение" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="AutostartCheck" Content="Запускать вместе с Windows"/>
                                        <CheckBox x:Name="TrayCheck" Content="Закрывать в трей"/>
                                        <CheckBox x:Name="AutoMonitorCheck" Content="Запускать мониторинг автоматически"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Оверлей" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="OverlayEnabledCheck" Content="Показывать оверлей" Checked="OverlayChanged" Unchecked="OverlayChanged"/>
                                        <CheckBox x:Name="ClickThroughCheck" Content="Не перехватывать мышь" Checked="OverlayChanged" Unchecked="OverlayChanged"/>
                                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="Размер" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="OverlayScaleSlider" Minimum="0.7" Maximum="1.8" SmallChange="0.05" ValueChanged="OverlaySlider_ValueChanged"/><TextBlock Grid.Column="2" x:Name="OverlayScaleText" Text="100%" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="Прозрачность" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/><Slider Grid.Row="2" Grid.Column="1" x:Name="OverlayOpacitySlider" Minimum="0.25" Maximum="1" SmallChange="0.05" ValueChanged="OverlaySlider_ValueChanged"/><TextBlock Grid.Row="2" Grid.Column="2" x:Name="OverlayOpacityText" Text="92%" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Офлайн-режим" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                                        <TextBlock Text="Статистика, история и настройки сохраняются только на этом компьютере. Интернет-синхронизация, онлайн-обновления и загрузка плагинов не используются." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Папка локальных данных" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="LocalDataPathText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource PrimaryButton}" Content="Сохранить настройки" HorizontalAlignment="Stretch" Click="SaveSettings_Click" Margin="0,0,0,18"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="2" Margin="24,0,24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="Локальные данные готовы" Foreground="#687796" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
